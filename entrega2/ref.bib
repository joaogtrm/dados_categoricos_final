@article{davietPrivateSchoolsProvide2023,
  title = {Do {{Private Schools Provide}} a {{Better Quality}} of {{Education}}? {{Beyond}} the {{Private}} – {{Public Divide}}. {{A}} Literature Review 1981-2022},
  shorttitle = {Do {{Private Schools Provide}} a {{Better Quality}} of {{Education}}?},
  author = {Daviet, Barbara},
  date = {2023},
  journaltitle = {Cahiers de la recherche sur l'éducation et les savoirs},
  shortjournal = {cres},
  volume = {22},
  pages = {33--58},
  issn = {1635-3544, 2265-7762},
  doi = {10.4000/cres.6274},
  url = {https://journals.openedition.org/cres/6274},
  urldate = {2026-07-11},
  abstract = {The neoliberal theory argues that private schools provide better-quality education than public schools, thus justifying an increasing involvement of non-state actors in education over the past decades. This paper focuses on primary and secondary education with the aim of informing the neoliberal argument. First, it presents the theoretical debate on the quality of education and private schools’ impact on it. Second, it reviews the empirical evidence on the differential impacts of the private and public education sectors on quality. It then looks at the public-private school debate through a different lens, assessing the two core characteristics of private schools, management autonomy and market orientation. Finally, it proposes that the debate should be a reframed by moving beyond the public-private divide.           ,              La théorie néolibérale affirme que les écoles privées dispensent un enseignement de meilleure qualité que les écoles publiques, justifiant ainsi l’implication croissante des acteurs non étatiques dans l’éducation au cours des dernières décennies. Cet article se concentre sur l’enseignement primaire et secondaire dans le but d’éclairer l’argumentaire néolibéral. Il présente tout d’abord le débat théorique sur la qualité de l’éducation et l’impact des écoles privées sur celle-ci. Puis, il passe en revue les preuves empiriques de l’impact différentiel des secteurs privé et public de l’éducation sur la qualité. Il aborde ensuite le débat sur les écoles publiques et privées sous un angle différent, en évaluant les deux principales caractéristiques des écoles privées, à savoir l’autonomie de gestion et l’orientation vers le marché. Enfin, il propose de recadrer le débat en dépassant le clivage public-privé.}
}

